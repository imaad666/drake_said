---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AlbumBackground from '../components/AlbumBackground.astro';
import AlbumStrip from '../components/AlbumStrip';
import QuoteHero from '../components/QuoteHero';
import PageEnter from '../components/PageEnter';
import LenisScroll from '../components/LenisScroll';
import { albums, getAlbum, getNavAlbums, pickQuote } from '../lib/albums';

export function getStaticPaths() {
  return albums.map((album) => ({
    params: { album: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
const quote = pickQuote(album);
const navAlbums = getNavAlbums();
const title = `${album.name} — Drake Said`;
---

<BaseLayout title={title} theme={album.theme} bodyClass="album-page">
  <LenisScroll client:only="react" transition:persist />
  <PageEnter client:only="react" />
  <AlbumBackground />
  <SiteHeader />
  <AlbumStrip client:load albums={navAlbums} activeSlug={album.slug} transition:persist="album-strip" />
  <QuoteHero client:load quote={quote} albumSlug={album.slug} />
</BaseLayout>
