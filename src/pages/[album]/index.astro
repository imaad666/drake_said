---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import AlbumBackground from '../../components/AlbumBackground.astro';
import AlbumStrip from '../../components/AlbumStrip.astro';
import AlbumTrackScroll from '../../components/AlbumTrackScroll';
import QuoteHero from '../../components/QuoteHero';
import AlbumTheme from '../../components/AlbumTheme';
import { albums, getNavAlbums, pickQuote } from '../../lib/albums';
import { albumHasTracks, getTracksForAlbum } from '../../lib/tracks';

export function getStaticPaths() {
  return albums.map((album) => ({
    params: { album: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
const navAlbums = getNavAlbums();
const hasTracks = albumHasTracks(album.slug);
const tracks = hasTracks ? getTracksForAlbum(album.slug) : [];
const quote = hasTracks ? null : pickQuote(album);
const title = `${album.name} — Drake Said`;
---

<BaseLayout
  title={title}
  theme={album.theme}
  fonts={album.fonts}
  bodyClass={`album-page${hasTracks ? ' album-page--tracks' : ''}`}
  pageTransition={false}
>
  <AlbumTheme client:load transition:persist="album-theme" theme={album.theme} fonts={album.fonts} />
  <AlbumBackground transition:persist="album-bg" />

  <section
    class:list={['album-chrome', hasTracks && 'album-chrome--tracks']}
    id="album-nav"
    aria-label="Album navigation"
  >
    <SiteHeader transition:persist="header-album" />
    <AlbumStrip albums={navAlbums} activeSlug={album.slug} />
  </section>

  <div class="album-content" transition:name="album-content" transition:animate="fade">
    {
      hasTracks ? (
        <AlbumTrackScroll client:load albumSlug={album.slug} tracks={tracks} />
      ) : (
        <QuoteHero
          client:load
          song={quote!.song}
          lines={quote!.lines}
          albumSlug={album.slug}
        />
      )
    }
  </div>
</BaseLayout>
