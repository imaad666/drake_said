---
import AnimatedHeader from './AnimatedHeader';

interface Props {
  homeHref?: string;
  /** Cycle through display fonts (home page). */
  cycleFonts?: boolean;
  /** Persist across view transitions (album chrome persists as a unit). */
  persist?: boolean;
}

const { homeHref = '/', cycleFonts = false, persist = true } = Astro.props;
---

<header
  class="site-header"
  transition:persist={cycleFonts ? 'header-home' : persist ? 'header-album' : undefined}
>
  {
    cycleFonts ? (
      <AnimatedHeader client:load homeHref={homeHref} />
    ) : (
      <h1 class="site-header__title">
        <a href={homeHref}>DRAKE SAID</a>
      </h1>
    )
  }
</header>
