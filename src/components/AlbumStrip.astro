---
import type { AlbumRecord } from '../lib/types';
import '../styles/album-strip.css';

interface Props {
  albums: AlbumRecord[];
  activeSlug: string;
}

const { albums, activeSlug } = Astro.props;
---

<nav class="album-strip" aria-label="Albums">
  {
    albums.map((album) => {
      const isActive = album.slug === activeSlug;
      return (
        <a
          href={`/${album.slug}`}
          class:list={['album-strip__link', { 'album-strip__link--active': isActive }]}
          aria-current={isActive ? 'page' : undefined}
          data-album-slug={album.slug}
          data-astro-prefetch="load"
        >
          <img
            src={album.cover}
            alt={album.name}
            width={64}
            height={64}
            loading="eager"
            decoding="async"
          />
        </a>
      );
    })
  }
</nav>

<script>
  type StripState = {
    bound: boolean;
    scrollLeft: number;
    pendingSlug: string | null;
  };

  const state: StripState = (window as Window & { __albumStrip?: StripState }).__albumStrip ?? {
    bound: false,
    scrollLeft: 0,
    pendingSlug: null,
  };
  (window as Window & { __albumStrip?: StripState }).__albumStrip = state;

  function currentAlbumSlug() {
    const parts = window.location.pathname.replace(/\/$/, '').split('/').filter(Boolean);
    return parts[0] ?? '';
  }

  function getStrip() {
    return document.querySelector<HTMLElement>('.album-strip');
  }

  function updateActiveSlug(slug: string) {
    document.querySelectorAll<HTMLAnchorElement>('.album-strip__link').forEach((link) => {
      const isActive = link.dataset.albumSlug === slug;
      link.classList.toggle('album-strip__link--active', isActive);
      if (isActive) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  function scrollStripToLink(link: HTMLElement) {
    const strip = link.closest('.album-strip') as HTMLElement | null;
    if (!strip) return;

    const links = Array.from(strip.querySelectorAll<HTMLAnchorElement>('.album-strip__link'));
    const index = links.indexOf(link as HTMLAnchorElement);
    const max = strip.scrollWidth - strip.clientWidth;

    if (index <= 0) {
      strip.scrollLeft = 0;
      return;
    }

    if (index === links.length - 1) {
      strip.scrollLeft = max;
      return;
    }

    const stripRect = strip.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    const target =
      strip.scrollLeft + linkRect.left + linkRect.width / 2 - (stripRect.left + stripRect.width / 2);
    strip.scrollLeft = Math.max(0, Math.min(max, target));
  }

  function isLinkVisible(link: HTMLElement, strip: HTMLElement) {
    const stripRect = strip.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();
    return linkRect.left >= stripRect.left - 4 && linkRect.right <= stripRect.right + 4;
  }

  function ensureActiveVisible(slug: string) {
    const strip = getStrip();
    const link = strip?.querySelector<HTMLElement>(`.album-strip__link[data-album-slug="${slug}"]`);
    if (!strip || !link || isLinkVisible(link, strip)) return;
    scrollStripToLink(link);
  }

  function saveStripScroll() {
    const strip = getStrip();
    if (strip) state.scrollLeft = strip.scrollLeft;
  }

  function restoreStripScroll() {
    const strip = getStrip();
    if (strip) strip.scrollLeft = state.scrollLeft;
  }

  function syncAlbumStrip({ restoreScroll = true, ensureVisible = false } = {}) {
    const slug = state.pendingSlug ?? currentAlbumSlug();
    state.pendingSlug = null;
    updateActiveSlug(slug);
    if (restoreScroll) restoreStripScroll();
    if (ensureVisible) ensureActiveVisible(slug);
    saveStripScroll();
  }

  function syncAlbumChromeClass() {
    const chrome = document.getElementById('album-nav');
    if (!chrome) return;
    chrome.classList.toggle('album-chrome--tracks', document.body.classList.contains('album-page--tracks'));
  }

  if (!state.bound) {
    state.bound = true;

    document.addEventListener('astro:before-swap', saveStripScroll);

    document.addEventListener('astro:after-swap', () => {
      syncAlbumChromeClass();
      syncAlbumStrip({ restoreScroll: true, ensureVisible: false });
    });

    document.addEventListener(
      'click',
      (e) => {
        const link = (e.target as Element).closest?.('.album-strip__link');
        if (!(link instanceof HTMLAnchorElement)) return;
        const slug = link.dataset.albumSlug;
        if (!slug) return;
        state.pendingSlug = slug;
        updateActiveSlug(slug);
        scrollStripToLink(link);
        saveStripScroll();
      },
      true,
    );

    syncAlbumChromeClass();
    syncAlbumStrip({ restoreScroll: false, ensureVisible: true });
  } else {
    syncAlbumChromeClass();
  }
</script>
